# NAVITIME Transfer API (可选,未设置时通勤分自动降级)
NAVITIME_CLIENT_KEY=
# 国土交通省 不動産情報ライブラリ API (可选, https://www.reinfolib.mlit.go.jp/ 申请)
REINFOLIB_API_KEY=
# 管理令牌：保护个人房源、收藏、设置的读写；Render 生产环境必须设置
ADMIN_TOKEN=
# SQLite DB路径 (Render部署时指向持久磁盘)
DB_PATH=
# Flask debug模式 (生产环境留空)
FLASK_DEBUG=
FLASK_ENV=development
